# PostgreSQL — remplacer par les vraies credentials de production
DATABASE_URL="postgresql://loyalty:loyalty@localhost:5432/loyalty_platform?schema=public"

PORT=3000
NODE_ENV=development

# URL publique de cette API — utilisée comme webServiceURL dans les passes Apple Wallet
# (Apple doit pouvoir l'appeler depuis Internet ; http://localhost ne fonctionnera jamais
# sur un vrai iPhone, il faudra une URL publique en production).
API_BASE_URL="http://localhost:3000"

# URL publique de la page d'inscription (frontend) — utilisée pour construire le lien
# encodé dans le QR code d'inscription de chaque entreprise.
FRONTEND_BASE_URL="http://localhost:5173"

# Secrets d'application — générer des valeurs aléatoires longues en production
# (jamais commiter de vraies valeurs dans ce fichier ; .env reste hors git)
SESSION_SECRET="replace-with-a-long-random-value"
JWT_SECRET="replace-with-a-long-random-value"

# Clé de chiffrement des tokens de fidélité (AES-256, 32 octets en base64).
# Générer une vraie valeur en production avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# --- Apple Wallet (à configurer plus tard avec les vraies credentials) ---
# Nécessite un compte Apple Developer Program (payant) et un certificat "Pass Type ID"
# créé sur developer.apple.com. Une fois le certificat .p12 exporté depuis Keychain Access,
# en extraire le certificat et la clé privée au format PEM avec OpenSSL :
#   openssl pkcs12 -in Certificates.p12 -clcerts -nokeys -out signerCert.pem -legacy
#   openssl pkcs12 -in Certificates.p12 -nocerts -out signerKey.pem -legacy
# Le certificat WWDR (intermédiaire Apple) se télécharge ici :
#   https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer  (à convertir en .pem)
APPLE_PASS_TYPE_IDENTIFIER="pass.com.example.loyalty"
APPLE_TEAM_IDENTIFIER=""
APPLE_PASS_SIGNER_CERT_PATH=""
APPLE_PASS_SIGNER_KEY_PATH=""
APPLE_PASS_SIGNER_KEY_PASSPHRASE=""
APPLE_WWDR_CERTIFICATE_PATH=""

# --- Google Wallet (à configurer plus tard avec les vraies credentials) ---
# 1. Créer un projet sur console.cloud.google.com et activer "Google Wallet API".
# 2. Demander l'accès "Google Wallet API Issuer" sur pay.google.com/business/console
#    (validation manuelle par Google, prend généralement quelques jours) — ça donne
#    un GOOGLE_WALLET_ISSUER_ID (identifiant numérique).
# 3. Créer un compte de service dans ce projet Google Cloud, générer une clé JSON,
#    puis l'ajouter comme "Issuer account user" dans la Google Pay & Wallet Console.
#    Le fichier JSON téléchargé contient client_email et private_key ci-dessous.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- E-mail (notifications clients, par entreprise) ---
# Pas de configuration globale ici : chaque entreprise configure son propre fournisseur SMTP
# (Resend, Postmark, SendGrid, AWS SES, Gmail...) directement depuis son dashboard
# ("Programme" > "E-mail"), stocké chiffré en base (voir TOKEN_ENCRYPTION_KEY plus haut,
# réutilisée pour ce chiffrement). Rien à faire ici au niveau serveur pour cette fonctionnalité.

# --- E-mail système (réinitialisation de mot de passe, alertes de sécurité) ---
# Distinct de l'e-mail par entreprise ci-dessus : celui-ci vient de LA PLATEFORME elle-même,
# une seule config pour tout le monde (ex: un compte Resend dédié "Carte Virtuelle").
SYSTEM_SMTP_HOST=""
SYSTEM_SMTP_PORT="587"
SYSTEM_SMTP_SECURE="false"
SYSTEM_SMTP_USER=""
SYSTEM_SMTP_PASSWORD=""
SYSTEM_EMAIL_FROM_ADDRESS=""
